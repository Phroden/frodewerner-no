---
import Base from "../layouts/Base.astro";
import ItemCard from "../components/ItemCard.astro";
import ProjectGrid from "../components/ProjectGrid.astro";
import { collection } from "../lib/herah";
const tjenester = (await collection("tjenester")).slice(0, 6);
const alle = await collection("prosjekter");
const prosjekter = alle.slice(0, 6);
const heroImg = alle.find((p) => p.cover)?.cover ?? null;
const strip = ["Reklamefilm", "Dokumentar", "Eventfilm", "Plakater", "Brosjyrer", "Kurs"];
---
<Base>
  <section class="home-hero" id="top">
    <div class="wrap">
      <div class="hero-text">
        <span class="badge"><i aria-hidden="true"></i>Film og trykk fra Nes på Romerike</span>
        <h1>Gode historier, <mark>fortalt</mark> på film og papir.</h1>
        <p>Jeg lager reklamefilm, dokumentar, eventfilm og trykksaker for bedrifter, kulturliv og foreninger. Personlig oppfølging fra første idé til ferdig fil – eller ferdig trykk.</p>
        <div class="cta-row">
          <a class="pill green" href="/prosjekter">Se prosjekter →</a>
          <a class="pill white" href="/kontakt">Ta en uforpliktende prat</a>
        </div>
      </div>
      <div class="hero-art">
        <div class={`frame${heroImg ? "" : " ph"}`}>{heroImg && <img src={heroImg} alt="" />}</div>
      </div>
    </div>
  </section>

  <div class="strip" aria-hidden="true">
    <div class="wrap">{strip.map((s, i) => <>{i > 0 && <i>✳︎</i>}<span>{s}</span></>)}</div>
  </div>

  {tjenester.length > 0 && (
    <section class="block" id="tjenester">
      <div class="wrap">
        <div class="sec-head">
          <div>
            <span class="eyebrow">Tjenester</span>
            <h2>Én leverandør for det som skal ses – på skjerm og på trykk.</h2>
          </div>
          <p>Film og trykksaker henger ofte sammen. Når det samme blikket står bak begge, får du et uttrykk som henger sammen også.</p>
        </div>
        <div class="grid">{tjenester.map((t, i) => <ItemCard item={t} index={i} href={t.link !== false ? `/tjenester/${t.id}` : "/tjenester"} />)}</div>
      </div>
    </section>
  )}

  {prosjekter.length > 0 && (
    <section class="block white" id="prosjekter">
      <div class="wrap">
        <div class="sec-head">
          <div>
            <span class="eyebrow">Utvalgte prosjekter</span>
            <h2>Nylig arbeid</h2>
          </div>
        </div>
        <ProjectGrid items={prosjekter} />
      </div>
    </section>
  )}

  <section class="block">
    <div class="wrap">
      <div class="sec-head"><div>
        <span class="eyebrow">Slik jobber jeg</span>
        <h2>Enkelt, tydelig og uten overraskelser.</h2>
      </div></div>
      <div class="steps">
        <div class="step"><b>01</b><h3>Idé og plan</h3><p>Vi tar en prat om hva du vil oppnå, hvem du snakker til og hva budsjettet tillater. Du får et konkret forslag og en fast pris.</p></div>
        <div class="step"><b>02</b><h3>Produksjon</h3><p>Opptak, foto og design – med deg involvert underveis, så det du får er det du så for deg.</p></div>
        <div class="step"><b>03</b><h3>Levering</h3><p>Ferdig film i formatene du trenger, og trykkfiler klare for trykkeriet – eller ferdig trykket og levert.</p></div>
      </div>
    </div>
  </section>

  <section class="band" id="om">
    <div class="wrap">
      <div class="about">
        <span class="eyebrow">Om meg</span>
        <h2>Hei, jeg heter Frode.</h2>
        <p>Jeg driver Frode Werner Film &amp; Media fra Nes på Romerike. Til daglig underviser jeg i medier og kommunikasjon, og på kveldstid står jeg i maskinrommet på Nes Kulturhus. Film, bilder og trykk har fulgt meg hele veien.</p>
        <p>Når du jobber med meg, snakker du med den som faktisk gjør jobben – fra første skisse til siste eksport.</p>
        <div class="facts"><span>Basert i Nes</span><span>Oppdrag i hele landet</span><span>Medieutdannet lærer</span></div>
      </div>
    </div>
  </section>

  <section class="band" id="kontakt">
    <div class="wrap">
      <div class="contact">
        <div>
          <h2>Har du en idé?<br />La oss ta en kaffe.</h2>
          <p>Fortell kort hva du tenker på, så kommer jeg tilbake med forslag og pris – vanligvis innen to virkedager.</p>
        </div>
        <a class="pill" href="/kontakt">Ta kontakt →</a>
      </div>
    </div>
  </section>
</Base>
