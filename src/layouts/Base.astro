---
import "@fontsource-variable/bricolage-grotesque";
import "@fontsource-variable/inter";
import "../styles/global.css";
import { home, menu } from "../lib/herah";
interface Props { title?: string; description?: string }
const { title, description = "Film, media og kurs – Frode Werner Film & Media." } = Astro.props;
const full = title ? `${title} – Frode Werner Film & Media` : "Frode Werner Film & Media";
const { kontakt, sections } = await home();
const path = Astro.url.pathname.replace(/\/$/, "") || "/";
// Menyen følger «Vis i menyen» i Herah (Nettsted); «Om meg» vises når seksjonen er synlig på forsiden. Kontakt vises alltid.
const inMenu = await menu();
const omVisible = sections.some((s) => s.key === "om" && s.visible);
const nav = [
  { href: "/tjenester", label: "Tjenester", show: !inMenu || inMenu.has("tjenester") },
  { href: "/prosjekter", label: "Prosjekter", show: !inMenu || inMenu.has("prosjekter") },
  { href: "/#om", label: "Om meg", show: omVisible },
].filter((n) => n.show);
---
<!doctype html>
<html lang="nb">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{full}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={full} />
    <meta property="og:description" content={description} />
    <meta property="og:locale" content="nb_NO" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />
  </head>
  <body>
    <header class="top">
      <div class="wrap">
        <a class="brand" href="/">
          <span class="mark" aria-hidden="true">FW</span>
          <span class="brand-name"><b>Frode Werner</b><small>Film &amp; Media</small></span>
        </a>
        <nav aria-label="Hovedmeny">
          {nav.map((n) => <a class="navlink" href={n.href} aria-current={path.startsWith(n.href) && n.href !== "/#om" ? "page" : undefined}>{n.label}</a>)}
          <a class="pill dark" href="/kontakt" aria-current={path.startsWith("/kontakt") ? "page" : undefined}>Ta kontakt</a>
        </nav>
      </div>
    </header>
    <main><slot /></main>
    <footer class="site">
      <div class="wrap">
        <div><b>Frode Werner Film &amp; Media</b>Årnes, Nes kommune{kontakt.orgnr && ` · Org.nr. ${kontakt.orgnr}`} · © {new Date().getFullYear()}</div>
        <nav aria-label="Bunnmeny">
          {nav.map((n) => <a class="navlink" href={n.href}>{n.label}</a>)}
          <a class="navlink" href="/kontakt">Kontakt</a>
        </nav>
      </div>
    </footer>
  </body>
</html>
