---
import type { Item } from "../lib/herah";
interface Props { item: Item; href?: string; index?: number }
const { item, href, index = 0 } = Astro.props;
const Tag = href ? "a" : "article";
---
<Tag class="card" href={href}>
  {item.cover && <img src={item.cover} alt="" loading="lazy" />}
  <div class="body">
    {!item.cover && <span class={`ico t${(index % 3) + 1}`} aria-hidden="true">✳︎</span>}
    {item.type.length > 0 && <ul class="tags">{item.type.map((t) => <li>{t}</li>)}</ul>}
    <h3>{item.title}</h3>
    {item.excerpt && <p>{item.excerpt}</p>}
  </div>
</Tag>
