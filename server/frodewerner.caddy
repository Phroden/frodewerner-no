# frodewerner.no – statisk nettside bygget av frodewerner-build (server/build-if-changed.sh) til /var/www/frodewerner.no.
# Installeres til /etc/caddy/sites/frodewerner.caddy av server/install.sh (Herahs Caddyfile importerer /etc/caddy/sites/*.caddy).
# Endrer du denne fila: kjør server/install.sh på nytt på serveren (den sjekker oppsettet og legger tilbake det gamle hvis noe er galt).

frodewerner.no {
	root * /var/www/frodewerner.no
	encode zstd gzip
	file_server

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		# Ingen skript eller stil i selve sidene; bilder ligger her (fra Herah bare hvis ett ikke kunne lastes ned ved bygging)
		Content-Security-Policy "default-src 'self'; img-src 'self' https://herah.frodewerner.no data:; style-src 'self'; font-src 'self'; script-src 'self'; object-src 'none'; frame-ancestors 'none'; base-uri 'none'; form-action 'self'; frame-src https://www.youtube-nocookie.com"
		-Server
	}
	# Filene i /_astro har innholdet i navnet og kan mellomlagres lenge; sidene sjekkes på nytt hver gang
	@assets path /_astro/*
	header @assets Cache-Control "public, max-age=31536000, immutable"
	@pages not path /_astro/*
	header @pages Cache-Control "no-cache"

	handle_errors {
		@notfound expression {err.status_code} == 404
		handle @notfound {
			rewrite * /404.html
			file_server
		}
	}
}

www.frodewerner.no {
	redir https://frodewerner.no{uri} permanent
}
